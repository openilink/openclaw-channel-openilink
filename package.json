{
  "name": "openclaw-channel-openilink",
  "version": "0.1.3",
  "description": "OpenClaw channel plugin for OpeniLink Hub — bridge WeChat bots via Hub",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "files": [
    "dist/",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "openilink",
    "wechat"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/openilink/openclaw-channel-openilink"
  },
  "peerDependencies": {
    "openclaw": ">=2025.0.0"
  },
  "devDependencies": {
    "openclaw": "*",
    "typescript": "^5.0.0",
    "@types/ws": "^8.0.0"
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}
